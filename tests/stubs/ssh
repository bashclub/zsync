#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Stub für ssh: protokolliert Optionen (sortiert), Host und Befehl und führt den Befehl als Quelle lokal aus.
opts=(); host=; i=0; args=("$@")
while (( i < ${#args[@]} )); do
  a=${args[i]}
  if [[ $a == -* ]]; then opts+=("$a")
  elif [[ -z $host ]]; then host=$a
  else break; fi
  ((i++))
done
cmd="${args[*]:i}"
# Szenario mit SSH_FAIL=1: Quelle nicht erreichbar (wie ssh: Exit 255)
SSH_FAIL=0; . "$ZTEST_SCENARIO"
if [[ $SSH_FAIL == 1 ]]; then
  echo "ssh [unreachable] $host: ${args[*]:i}" >> "$ZTEST_LOG"
  echo "ssh: connect to host $host port 22: Connection refused" >&2; exit 255
fi
echo "ssh [$(printf '%s\n' "${opts[@]}" | sort | tr '\n' ' ')] $host: $cmd" >> "$ZTEST_LOG"
# mit ZTEST_WRAPPER läuft der Befehl wie mit command= in authorized_keys über bashclub-zsync-remote
if [[ -n ${ZTEST_WRAPPER-} ]]; then SSH_ORIGINAL_COMMAND=$cmd ZSIDE=source exec "$ZTEST_WRAPPER"; fi
ZSIDE=source exec bash -c "$cmd"
