#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Stub für zfs: protokolliert jeden Aufruf und antwortet aus den Daten des Szenarios.
# Seite: ZSIDE=source (per ssh-Stub) oder target (lokal).
side=${ZSIDE:-target}
# receive erst nach dem Ende des Streams protokollieren, damit die Reihenfolge in Pipes eindeutig ist
[[ $1 == receive ]] && cat > /dev/null
echo "$side: zfs $*" >> "$ZTEST_LOG"
declare -A SNAPS_source_post=() TYPES=() REFQUOTA_source=() REFQUOTA_target=() CREATION_source=() ORPHAN_KEEP=() BOOKMARKS_source=() RESUME_TOKEN=()
source "$ZTEST_SCENARIO"

# Snapshots einer Seite: "<snapshot> <guid>" je Zeile, älteste zuerst.
# Nach dem ersten send gilt auf der Quelle SNAPS_source_post (z. B. Retention während der Replikation).
snaps() {
  local v="SNAPS_${side}"
  [[ $side == source && -e $ZTEST_STATE/sent && -n ${SNAPS_source_post[$1]+x} ]] && v=SNAPS_source_post
  local -n m=$v
  # nach "zfs rollback -r <ds>@<snap>" fehlen auf dem Ziel alle neueren Snapshots
  local rb="$ZTEST_STATE/rollback_${1//\//_}"
  if [[ $side == target && -f $rb ]]; then
    printf '%s' "${m[$1]}" | sed '/^$/d' | sed "/^$(sed 's#[/.]#\\&#g' "$rb") /q"
  else
    printf '%s' "${m[$1]}" | sed '/^$/d'
  fi
}
datasets() { local v="DATASETS_${side}"; printf '%s\n' ${!v}; }

case $1 in
  list)
    shift; cols=name; sort=; type=; ds=; rec=
    while (( $# )); do
      case $1 in -H|-Hp|-p) ;; -r) rec=1 ;; -o) cols=$2; shift ;; -s) sort=asc; shift ;; -S) sort=desc; shift ;; -t) type=$2; shift ;; *) ds=$1 ;; esac
      shift
    done
    # rekursiv unter einem Dataset: Datasets (name, used) bzw. Snapshots aller Datasets darunter
    if [[ -n $rec ]]; then
      for d in $(datasets | grep -E "^$ds(/|\$)"); do
        if [[ $type == snapshot ]]; then snaps "$d" | cut -d' ' -f1; else
          line=; IFS=, read -ra c <<< "$cols"
          for f in "${c[@]}"; do case $f in name) v=$d ;; used) v=1G ;; esac; line+="${line:+$'\t'}$v"; done
          echo "$line"
        fi
      done; exit 0
    fi
    # Bookmarks: "<dataset>#<name> <guid>" je Zeile, createtxg = guid
    if [[ $type == bookmark ]]; then
      bm="BOOKMARKS_${side}[$ds]"
      while read -r n g; do [[ -n $n ]] && printf '%s\t%s\t%s\n' "$n" "$g" "$g"; done <<< "${!bm}"
      exit 0
    fi
    # einzelner Snapshot (dataset@name): existiert er?
    if [[ $ds == *@* ]]; then
      snaps "${ds%@*}" | awk -v s="$ds" '$1 == s { print $1; f = 1 } END { exit !f }'; exit
    fi
    if [[ $type != snapshot && -z $ds ]]; then
      # Spalten name, type, refquota (Bytes, 0 = none, "-" für Volumes)
      for d in $(datasets); do
        t=${TYPES[$d]:-filesystem}; q=0; [[ $t == volume ]] && q=-
        rq="REFQUOTA_${side}[$d]"; [[ -n ${!rq+x} ]] && q=${!rq}
        line=; IFS=, read -ra c <<< "$cols"
        for f in "${c[@]}"; do case $f in name) v=$d ;; type) v=$t ;; refquota) v=$q ;; esac; line+="${line:+$'\t'}$v"; done
        echo "$line"
      done; exit 0
    fi
    if [[ $type != snapshot ]]; then datasets | grep -qx "$ds" && { echo "$ds"; exit 0; }; echo "cannot open '$ds': dataset does not exist" >&2; exit 1; fi
    datasets | grep -qx "$ds" || { echo "cannot open '$ds': dataset does not exist" >&2; exit 1; }
    out=$(snaps "$ds")
    [[ $sort == desc ]] && out=$(tac <<< "$out")
    [[ -z $out ]] && exit 0
    while read -r n g; do
      line=; IFS=, read -ra c <<< "$cols"
      # creation eines Snapshots = seine guid (Szenarien mit Zeitbezug nutzen Zahlen als guid)
      for f in "${c[@]}"; do case $f in name) v=$n ;; guid|creation|createtxg) v=$g ;; esac; line+="${line:+$'\t'}$v"; done
      echo "$line"
    done <<< "$out"
    ;;
  get)
    case "$*" in
      "get -H -o name,value,source -t filesystem,volume "*) printf '%s\n' "$TAGS" ;;
      "get -H -o value type "*) echo "${TYPES[${@: -1}]:-filesystem}" ;;
      "get -H -o value,source com.sun:auto-snapshot "*) printf 'false\tlocal\n' ;;
      "get -H -o value canmount "*) echo "${CANMOUNT:-noauto}" ;;
      "get -H -o value mounted "*) echo "${MOUNTED:-yes}" ;;
      "get -H -o value receive_resume_token "*) echo "${RESUME_TOKEN[${@: -1}]:--}" ;;
      "get -H -o value guid "*)
        obj=${@: -1}; ds=${obj%%[@#]*}; sv="SNAPS_${side}[$ds]"; bv="BOOKMARKS_${side}[$ds]"
        printf '%s\n%s\n' "${!sv}" "${!bv}" | awk -v o="$obj" '$1 == o { print $2 }' ;;
      "get -Hp -o value creation "*) echo "${CREATION_source[${@: -1}]:-0}" ;;
      "get -H -o name,value -r -t filesystem,volume bashclub:zsync-orphan "*)
        for d in $(datasets | grep -E "^${@: -1}(/|\$)"); do echo "$d"$'\t'"${ORPHAN_KEEP[$d]:--}"; done ;;
      "get -Hp -o value refquota "*) rq="REFQUOTA_${side}[${@: -1}]"; echo "${!rq:-0}" ;;
      # Originalwerte für das Replikat: mountpoint geerbt, canmount Default, auto-snapshot lokal, refquota, Tag
      "get -H -o name,property,value,source -t filesystem,volume mountpoint,canmount,com.sun:auto-snapshot,refquota,"*)
        for d in $(datasets); do
          printf '%s\tmountpoint\t/%s\tinherited from %s\n%s\tcanmount\ton\tdefault\n' "$d" "$d" "${d%%/*}" "$d"
          printf '%s\tcom.sun:auto-snapshot\ttrue\tlocal\n%s\trefquota\tnone\tdefault\n' "$d" "$d"
        done ;;
      # gespeicherte Originalwerte am Replikat: noch keine
      "get -H -o property,value -s local all "*) ;;
    esac
    ;;
  send) touch "$ZTEST_STATE/sent"; echo "STREAM $*" ;;
  receive)
    [[ -n $RECV_FAIL && "$*" == *$RECV_FAIL* ]] && { echo "cannot receive: simulated failure" >&2; exit 1; }
    ;;
  rollback) echo "${@: -1}" > "$ZTEST_STATE/rollback_$(cut -d@ -f1 <<< "${@: -1}" | tr / _)" ;;
  create|set|destroy|bookmark|hold|release) ;;
esac
exit 0
