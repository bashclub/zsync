#!/bin/bash
# Stub für zfs: protokolliert jeden Aufruf und antwortet aus den Daten des Szenarios.
# Seite: ZSIDE=source (per ssh-Stub) oder target (lokal).
side=${ZSIDE:-target}
# receive erst nach dem Ende des Streams protokollieren, damit die Reihenfolge in Pipes eindeutig ist
[[ $1 == receive ]] && cat > /dev/null
echo "$side: zfs $*" >> "$ZTEST_LOG"
source "$ZTEST_SCENARIO"

# Snapshots einer Seite: "<snapshot> <guid>" je Zeile, älteste zuerst
snaps() { local v="SNAPS_${side}"; local -n m=$v; printf '%s' "${m[$1]}" | sed '/^$/d'; }
datasets() { local v="DATASETS_${side}"; printf '%s\n' ${!v}; }

case $1 in
  list)
    shift; cols=name; sort=; type=; ds=
    while (( $# )); do
      case $1 in -H) ;; -o) cols=$2; shift ;; -s) sort=asc; shift ;; -S) sort=desc; shift ;; -t) type=$2; shift ;; *) ds=$1 ;; esac
      shift
    done
    if [[ $type != snapshot ]]; then datasets | grep -qx "$ds" && { echo "$ds"; exit 0; }; echo "cannot open '$ds': dataset does not exist" >&2; exit 1; fi
    datasets | grep -qx "$ds" || { echo "cannot open '$ds': dataset does not exist" >&2; exit 1; }
    out=$(snaps "$ds")
    [[ $sort == desc ]] && out=$(tac <<< "$out")
    [[ -z $out ]] && exit 0
    while read -r n g; do
      line=; IFS=, read -ra c <<< "$cols"
      for f in "${c[@]}"; do case $f in name) v=$n ;; guid) v=$g ;; esac; line+="${line:+$'\t'}$v"; done
      echo "$line"
    done <<< "$out"
    ;;
  get)
    case "$*" in
      "get -H -o name,value,source -t filesystem,volume "*) printf '%s\n' "$TAGS" ;;
      "get -H -o value type "*) echo "${TYPES[${@: -1}]:-filesystem}" ;;
      "get -H -o value,source com.sun:auto-snapshot "*) printf 'false\tlocal\n' ;;
      "get -H -o value canmount "*) echo "${CANMOUNT:-noauto}" ;;
    esac
    ;;
  send) echo "STREAM $*" ;;
  receive)
    [[ -n $RECV_FAIL && "$*" == *$RECV_FAIL* ]] && { echo "cannot receive: simulated failure" >&2; exit 1; }
    ;;
  create|set|destroy) ;;
esac
exit 0
