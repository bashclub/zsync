PATH="/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin"

# testing versions before 2.0 had the license as folder /usr/share/doc/bashclub-zsync-source/copyright/LICENSE
if [ -d /usr/share/doc/bashclub-zsync-source/copyright ]; then
  rm -rf /usr/share/doc/bashclub-zsync-source/copyright
fi
exit 0
