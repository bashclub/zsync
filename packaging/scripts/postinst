#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

PATH="/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin"

# log folder only for root (logrotate rotates only in folders that no other user or group may write), as in 1.0.19;
# a folder made writable for the group by a testing version before 2.0 gets these permissions back
if [ ! -d /var/log/bashclub-zsync ] || [ "$(stat -c %G /var/log/bashclub-zsync)" = bashclub-zsync ] || [ -g /var/log/bashclub-zsync ]; then
  install -d -o root -g root /var/log/bashclub-zsync
  # five digits: also removes the setgid bit of the testing version (a numeric mode keeps it otherwise)
  chmod 00755 /var/log/bashclub-zsync
fi

# group for running bashclub-zsync without root: its users create their own folder of the run status
# (/run/bashclub-zsync/<user>, /var/lib/bashclub-zsync/<user>); sticky bit: no one changes the folder of another user
getent group bashclub-zsync > /dev/null || groupadd --system bashclub-zsync
install -d -o root -g bashclub-zsync /var/lib/bashclub-zsync /run/bashclub-zsync
install -d -o root -g root /var/lib/bashclub-zsync/root /run/bashclub-zsync/root
chmod 01775 /var/lib/bashclub-zsync /run/bashclub-zsync
chmod 00755 /var/lib/bashclub-zsync/root /run/bashclub-zsync/root
# /run is created again at boot by systemd-tmpfiles (tmpfiles.d/bashclub-zsync.conf)
# status files of testing versions before 2.0 directly in the base folders (now one folder per user)
find /var/lib/bashclub-zsync /run/bashclub-zsync -maxdepth 1 -type f -delete 2> /dev/null

chown root:root /usr/bin/bashclub-zsync
chmod 755 /usr/bin/bashclub-zsync
chown root:root /usr/bin/remote-snapshot-manager
chmod 755 /usr/bin/remote-snapshot-manager
chown root:root /usr/bin/zsync-autorun
chmod 755 /usr/bin/zsync-autorun

if [ -f /etc/logrotate.d/bashclub_zsync ]; then
  rm -f /etc/logrotate.d/bashclub_zsync
fi

chown root:root /etc/logrotate.d/bashclub-zsync
chmod 644 /etc/logrotate.d/bashclub-zsync
if [ ! -f /etc/bashclub/zsync.conf ] && [ -f /etc/bashclub/zsync.conf.backup_$(date +%Y-%m-%d) ] ; then
  cp /etc/bashclub/zsync.conf.backup_$(date +%Y-%m-%d) /etc/bashclub/zsync.conf
fi

# checkmk local check: link into the agent if it is installed (also when the agent is installed later,
# via dpkg trigger) and unless disabled with /etc/bashclub/zsync-checkmk.disabled
check=/usr/share/bashclub-zsync/checkmk/bashclub_zsync
link=/usr/lib/check_mk_agent/local/bashclub_zsync
if [ -d /usr/lib/check_mk_agent ] && [ ! -e /etc/bashclub/zsync-checkmk.disabled ]; then
  mkdir -p /usr/lib/check_mk_agent/local
  ln -sfn $check $link
elif [ -L $link ]; then
  rm -f $link
fi

# systemd timers instead of cron: only a hint, existing cron jobs are not changed automatically
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload > /dev/null 2>&1 || true
  if grep -rlsE '^[^#]*bashclub-zsync[[:space:]].*-c[[:space:]]' /etc/crontab /etc/cron.d /var/spool/cron/crontabs /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly > /dev/null 2>&1; then
    echo "bashclub-zsync: cron jobs found, systemd timers are available now (bashclub-zsync@<name>.timer):"
    echo "    bashclub-zsync-timer migrate --dry-run"
  fi
fi
