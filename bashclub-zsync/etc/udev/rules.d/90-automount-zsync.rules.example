# bashclub-zsync-disk create writes this rule per disk: /etc/udev/rules.d/90-zsync-autorun-<label>.rules
# UUID of the partition (LUKS: blkid -s UUID -o value <partition>, without LUKS: the pool guid, same command)
# ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="<uuid>", ENV{SYSTEMD_WANTS}+="zsync-autorun@<label>.service"
