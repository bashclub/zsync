# Removable disk for zsync-autorun, step by step
# The script bashclub-zsync-disk does all of this with checks (see README, "Removable disks"):
#   bashclub-zsync-disk list
#   bashclub-zsync-disk create <disk> <label> --luks --passphrase --config <name>
# The manual steps below are the same, for reference.

# whole disk (see bashclub-zsync-disk list) and the name of the pool
disk=/dev/disk/by-id/usb-...
label=usb-backup3

# required packages
apt install cryptsetup udisks2 zfsutils-linux yubikey-manager

# wipe the disk, GPT with one partition
wipefs -a ${disk}
echo -e 'label: gpt\n,,L' | sfdisk ${disk}
udevadm settle
part=$(lsblk -lnpo NAME,TYPE $(readlink -f ${disk}) | awk '$2 == "part" { print $1; exit }')

# key file (keep a copy outside of this host)
(umask 077; dd if=/dev/urandom of=/etc/bashclub/${label}.key bs=64 count=1)

# LUKS2 on the partition (not on the whole disk), the LUKS label is the pool name
cryptsetup luksFormat --type luks2 --label ${label} --key-file /etc/bashclub/${label}.key ${part}

# optional: YubiKey with a static password as second key (slot 2: press the button for 2 seconds),
# then press the button when asked for the new passphrase (twice)
ykman otp static --generate 2
cryptsetup luksAddKey --key-file /etc/bashclub/${label}.key ${part}

# open with the name of the pool, zsync-autorun opens it the same way
cryptsetup open --key-file /etc/bashclub/${label}.key ${part} ${label}

# pool, then export it and close LUKS
zpool create -o ashift=12 -m none -O com.sun:auto-snapshot=false -O compression=lz4 ${label} /dev/mapper/${label}
zpool export ${label}
cryptsetup close ${label}

# udev rule with the UUID of the LUKS partition: connecting the disk starts zsync-autorun@<label>
cat << EOF > /etc/udev/rules.d/90-zsync-autorun-${label}.rules
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="$(blkid -s UUID -o value ${part})", ENV{SYSTEMD_WANTS}+="zsync-autorun@${label}.service"
EOF
udevadm control --reload

# configuration of the replication (target in the pool <label>), used by zsync-autorun
ln -sfn /etc/bashclub/<name>.conf /etc/default/zsync-autorun@${label}

# power off the disk
udisksctl power-off --block-device $(readlink -f ${disk})
